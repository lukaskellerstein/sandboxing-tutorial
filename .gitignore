# Secrets — never commit. A committed `.env.example` is the template; the real
# values come from ~/.secrets/secrets.enc.yaml via direnv.
.env
.envrc
*.key
*.pem
*.agekey
kubeconfig
*.kubeconfig

# Claude Code machine-local overrides
.claude/settings.local.json

# Python
__pycache__
__pycache__/
*.pyc
.venv/
.python-version

# Tool caches
.ruff_cache/
.pytest_cache/
.mypy_cache/

# Lesson scorecards — regenerated by each run; lesson 14 renders the final table
# from these. Never hand-entered, never committed.
results/

# infra state — names live, billable Scaleway resources. Never committed: a stale
# entry in someone else's clone is how the wrong box gets destroyed.
infra/.state/

# Terraform — state names live, billable resources; the provider cache is ~100MB of binaries.
infra/terraform/.terraform/
infra/terraform/*.tfstate
infra/terraform/*.tfstate.*
infra/terraform/*.tfplan
# .terraform.lock.hcl is deliberately NOT ignored — it pins the provider's version and hashes, which
# is what makes a reader's `terraform init` resolve the same provider this was verified against.

# Playwright MCP scratch output (screenshots, accessibility snapshots, console logs).
.playwright-mcp/
