# Secrets — never commit. A committed `.env.example` is the template; the real
# values come from ~/.secrets/secrets.enc.yaml via direnv.
.env
.envrc
*.key
*.pem
*.agekey
kubeconfig
*.kubeconfig

# Claude Code machine-local overrides
.claude/settings.local.json

# Python
__pycache__
__pycache__/
*.pyc
.venv/
.python-version

# Tool caches
.ruff_cache/
.pytest_cache/
.mypy_cache/

# Lesson scorecards — regenerated by each run; lesson 14 renders the final table
# from these. Never hand-entered, never committed.
results/

# infra state — names live, billable Scaleway resources. Never committed: a stale
# entry in someone else's clone is how the wrong box gets destroyed.
infra/.state/

# Derived from the run files in infra/.state/, and rebuildable from them
# (`ctl.py timings --rebuild`). Committing it would ship this machine's stage
# durations as if they were the repo's.
infra/timings.db

# sbx-tui's dependencies. The TUI is the ONLY Node in this repo and nothing else depends on it —
# `ctl.py` and every shell script run on a clone with nothing installed. package-lock.json IS
# committed to pin what a reader's `npm install`
# resolves to.
infra/tui/node_modules/

# Playwright MCP scratch output (screenshots, accessibility snapshots, console logs).
.playwright-mcp/
